<view class="container">

  <view class="card">
    <view class="title">巴法云配置</view>
    <view class="desc">填写你在 bemfa.com 后台「用户中心」私钥和主题。保存后立即生效，重启小程序无需重新填写。</view>

    <view class="form-item">
      <view class="label">巴法云 私钥</view>
      <input class="input" value="{{uid}}" bindinput="onUidInput" placeholder="如：0123456789abcdef0123456789abcdef" maxlength="40"/>
    </view>

    <view class="form-item">
      <view class="label">设备主题</view>
      <input class="input" value="{{topic}}" bindinput="onTopicInput" placeholder="如：Test01" maxlength="32"/>
    </view>

    <view class="hint">填写说明</view>
    <view class="hint-list">
      <view>· 私钥在巴法云后台 → 用户中心 复制</view>
      <view>· 保存到本地后会自动重连，3 秒后首页有数据</view>
    </view>

    <button class="btn btn-save" bindtap="onSave">💾 保存配置</button>
    <button class="btn btn-clear" bindtap="onClear">🗑️ 清除配置（恢复默认）</button>
  </view>

  <view class="card">
    <view class="title">数据刷新间隔</view>
    <view class="desc">设置首页从云端拉取传感器数据的轮询间隔。改完保存后立即生效。</view>

    <view class="form-item">
      <view class="label">刷新间隔（秒）</view>
      <input class="input" type="digit" value="{{pollSec}}" bindinput="onPollInput" placeholder="如 3" maxlength="6"/>
    </view>

    <button class="btn btn-save" bindtap="onSavePoll">💾 保存刷新间隔</button>
  </view>

  <view class="card">
    <view class="title">云端历史（CloudBase）</view>

    <view class="form-item">
      <view class="label">云函数地址</view>
      <input class="input" value="{{cloudBase}}" bindinput="onCloudBaseInput" placeholder="https://xxx.service.tcloudbase.com/getHistory" maxlength="200"/>
    </view>

    <view class="form-item">
      <view class="label">访问令牌（未设置则留空）</view>
      <input class="input" value="{{cloudToken}}" bindinput="onCloudTokenInput" placeholder="云函数 ACCESS_TOKEN" maxlength="64"/>
    </view>

    <button class="btn btn-save" bindtap="onSaveCloud">💾 保存云端配置</button>
    <button class="btn btn-clear" bindtap="onTestCloud">🔍 测试连接</button>
  </view>

  <view class="card">
    <view class="title">🤖 AI 助手（后端接入）</view>
    <view class="desc">AI 由本项目后端（server/server.js）调用，密钥只在服务端，这里只需填后端地址。</view>

    <view class="form-item">
      <view class="label">后端地址</view>
      <input class="input" value="{{aiBase}}" bindinput="onAiBaseInput" placeholder="http://192.168.1.9:8080/api/ai" maxlength="200"/>
    </view>

    <button class="btn btn-save" bindtap="onSaveAi">💾 保存</button>
    <button class="btn btn-clear" bindtap="onTestAi" disabled="{{aiTesting}}">🔍 {{aiTesting ? '检测中…' : '检测 AI 后端'}}</button>

    <view wx:if="{{aiTestText}}" class="ai-test {{aiTestOk ? 'ai-test-ok' : 'ai-test-err'}}" bindlongpress="onAiTestLongPress">{{aiTestText}}</view>

    <view class="hint">怎么用</view>
    <view class="hint-list">
      <view>· 先在电脑上运行：node server/server.js</view>
      <view>· 手机与电脑连同一 WiFi 时，填电脑的局域网 IP（ipconfig 查看）</view>
      <view>· 正式上线需在小程序后台「开发管理 → 服务器域名」加入该域名；开发阶段可在开发者工具勾选"不校验合法域名"</view>
      <view>· 长按检测结果可复制错误信息</view>
    </view>
  </view>

  <view class="card">
    <view class="title">关于</view>
    <view class="about-row"><text class="key">版本</text><text>v2.0</text></view>
    <view class="about-row"><text class="key">云平台</text><text>巴法云 bemfa.com</text></view>
    <view class="about-row"><text class="key">设备主题</text><text>{{topic || '未配置'}}</text></view>
  </view>
</view>