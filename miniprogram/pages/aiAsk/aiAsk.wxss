/* AI quick-ask page: one question in, one answer out. ASCII comments only. */
page {
  background: #f2f5f7;
  min-height: 100vh;
}
.page {
  padding: 20rpx 24rpx 60rpx;
}

/* ---------- status bar ---------- */
.bar {
  background: linear-gradient(135deg, #2e86ab, #1f9e8f);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
}
.bar-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.bar-sub {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  margin-top: 6rpx;
  word-break: break-all;
}

/* ---------- card ---------- */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.card-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #233240;
  margin-bottom: 14rpx;
}
.card-head .card-title {
  margin-bottom: 14rpx;
}

/* ---------- question ---------- */
.q-input {
  width: 100%;
  box-sizing: border-box;
  background: #f6f9fa;
  border: 1rpx solid #dfe6e9;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #233240;
  min-height: 120rpx;
}

/* ---------- button ---------- */
.btn {
  margin-top: 18rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 2.2;
}
.btn-ask {
  background: linear-gradient(135deg, #7e57c2, #4527a0);
  color: #fff;
}
.btn-clear {
  background: #eee;
  color: #555;
}

/* ---------- loading ---------- */
.loading-card {
  text-align: center;
}
.loading-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.loading-ico {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.loading-text {
  font-size: 27rpx;
  color: #455a64;
}
.tip-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #90a4ae;
}

/* ---------- answer ---------- */
.answer {
  display: block;
  font-size: 27rpx;
  line-height: 1.85;
  color: #233240;
  word-break: break-word;
  white-space: pre-wrap;
}
.copy {
  font-size: 24rpx;
  color: #1f9e8f;
  padding: 6rpx 10rpx;
}
.err-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #b03a2e;
  word-break: break-word;
}
.ctx-info {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #dfe6e9;
  font-size: 21rpx;
  color: #90a4ae;
}

.footer {
  margin-top: 8rpx;
  text-align: center;
  font-size: 21rpx;
  color: #90a4ae;
  line-height: 1.6;
  padding: 0 20rpx;
}
