page {
  background: #f4f8fa;
  width: 100%;
  height: 100%;
}
.wrap {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
}
.title {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
  text-align: center;
  margin-bottom: 8rpx;
}
.chart-box {
  flex: 1;
  width: 100%;
  background: #fbfdfe;
  border-radius: 12rpx;
  overflow: hidden;
}
.chart {
  width: 100%;
  height: 100%;
}
.tip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8a9aa8;
  text-align: center;
}
