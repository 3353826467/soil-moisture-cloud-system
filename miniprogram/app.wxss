/* app.wxss - Global styles (English-only to avoid encoding issues) */
page {
  background-color: #f0f4f8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #2c3e50;
}

.container { padding: 20rpx; min-height: 100vh; box-sizing: border-box; }

/* Hero block */
.hero {
  background: linear-gradient(135deg, #2E86AB 0%, #4FA8D5 100%);
  border-radius: 24rpx; padding: 32rpx 24rpx; color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(46,134,171,0.25);
}
.hero-row { display: flex; justify-content: space-around; align-items: center; }
.hero-item { text-align: center; flex: 1; }
.hero-label { font-size: 22rpx; opacity: 0.85; margin-bottom: 8rpx; }
.hero-value { font-size: 56rpx; font-weight: bold; line-height: 1.1; }
.hero-unit  { font-size: 26rpx; opacity: 0.85; margin-left: 4rpx; }
.hero-sub   { font-size: 20rpx; opacity: 0.8; margin-top: 12rpx; text-align: center; }

/* Status row */
.status-row {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  display: flex; justify-content: space-around;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.status-cell { text-align: center; flex: 1; }
.status-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.status-label { font-size: 22rpx; color: #7f8c8d; margin-bottom: 6rpx; }
.status-value { font-size: 28rpx; font-weight: bold; }
.status-value.online  { color: #27ae60; }
.status-value.offline { color: #e74c3c; }

/* Sensor grid 2x2 */
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.card {
  background: #fff; border-radius: 16rpx; padding: 28rpx 20rpx;
  width: 48%; margin-bottom: 20rpx; box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  display: flex; align-items: center;
}
.card-icon {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-right: 16rpx; flex-shrink: 0;
}
.card-icon.sh { background: #e3f2fd; color: #1976d2; }
.card-icon.st { background: #fff3e0; color: #f57c00; }
.card-icon.ah { background: #e0f7fa; color: #00838f; }
.card-icon.at { background: #fff8e1; color: #ffa000; }
.card-body { flex: 1; }
.card-title { font-size: 22rpx; color: #7f8c8d; margin-bottom: 6rpx; }
.card-value { font-size: 36rpx; font-weight: bold; color: #2c3e50; line-height: 1; }
.card-unit  { font-size: 22rpx; color: #7f8c8d; margin-left: 2rpx; font-weight: normal; }

/* Control section */
.control {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.control-title { font-size: 26rpx; color: #2c3e50; margin-bottom: 20rpx; font-weight: bold; }
.btn-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.btn {
  flex: 1; min-width: 200rpx; font-size: 26rpx;
  border-radius: 12rpx; border: none; color: #fff;
  padding: 20rpx 0;
}
.btn::after { border: none; }
.btn-on   { background: #27ae60; }
.btn-off  { background: #e74c3c; }
.btn-test { background: #f39c12; }
.btn-set  { background: #2E86AB; }

/* Footer */
.footer {
  text-align: center; color: #95a5a6;
  font-size: 22rpx; margin-top: 16rpx;
}

/* Settings page styles (shared) */
.form-card {
  background: #fff; border-radius: 16rpx;
  padding: 32rpx 24rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.form-row { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #2c3e50; margin-bottom: 12rpx; display: block; }
.form-input {
  border: 1rpx solid #dcdfe6; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 28rpx; width: 100%;
  box-sizing: border-box;
}
.form-tip { font-size: 22rpx; color: #95a5a6; margin-top: 6rpx; }

.btn-save {
  background: linear-gradient(135deg, #2E86AB 0%, #4FA8D5 100%);
  color: #fff; border-radius: 12rpx; padding: 24rpx;
  font-size: 30rpx; font-weight: bold; width: 100%;
  margin-top: 24rpx; border: none;
}
.btn-save::after { border: none; }

.btn-test-conn {
  background: #f39c12; color: #fff; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; width: 100%; margin-top: 16rpx;
  border: none;
}
.btn-test-conn::after { border: none; }

.result-ok    { color: #27ae60; font-size: 26rpx; text-align: center; padding: 16rpx 0; }
.result-error { color: #e74c3c; font-size: 26rpx; text-align: center; padding: 16rpx 0; }